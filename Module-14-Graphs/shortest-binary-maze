## Shortest Path in a Binary Maze (C++ – BFS)

```cpp
int shortestPath(vector<vector<int>> mat,
                 int srcR, int srcC,
                 int destR, int destC,
                 int m, int n) {

    // If source or destination is blocked
    if (mat[srcR][srcC] == 0 || mat[destR][destC] == 0)
        return -1;

    vector<vector<bool>> visited(m, vector<bool>(n, false));
    queue<pair<int, int>> q;

    q.push({srcR, srcC});
    visited[srcR][srcC] = true;

    int distance = 0;

    // 4 possible directions: down, up, right, left
    int dx[4] = {1, -1, 0, 0};
    int dy[4] = {0, 0, 1, -1};

    while (!q.empty()) {

        int size = q.size();   // nodes at current level

        while (size--) {

            auto front = q.front();
            q.pop();

            int x = front.first;
            int y = front.second;

            // Destination reached
            if (x == destR && y == destC)
                return distance;

            // Explore neighbors
            for (int i = 0; i < 4; i++) {

                int nx = x + dx[i];
                int ny = y + dy[i];

                if (nx >= 0 && nx < m &&
                    ny >= 0 && ny < n &&
                    mat[nx][ny] == 1 &&
                    !visited[nx][ny]) {

                    visited[nx][ny] = true;
                    q.push({nx, ny});
                }
            }
        }
        distance++; // increase distance after each level
    }

    return -1; // destination not reachable
}
